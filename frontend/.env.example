# Backend API URL for Vite Frontend
# In development (localhost): leave empty to use Vite's proxy (http://127.0.0.1:8000)
# In production (e.g. Vercel deployment): set to your deployed backend URL (e.g. Render / Railway)
# Example: https://your-backend.onrender.com
VITE_API_BASE_URL=

# Alternatively, VITE_API_URL is also supported:
# VITE_API_URL=https://your-backend.onrender.com
